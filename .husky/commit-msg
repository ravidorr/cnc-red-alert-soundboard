#!/usr/bin/env sh
# Minimum subject length. This repository uses GitHub issues, so no ticket-key prefix is required.
msg_file="$1"
msg="$(head -n 1 "$msg_file")"

if printf '%s\n' "$msg" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+$'; then
  exit 0
fi

if [ "${#msg}" -lt 15 ]; then
  echo "commit-msg: subject must be at least 15 characters." >&2
  exit 1
fi
