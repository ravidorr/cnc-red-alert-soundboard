{
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ravidorr"
  },
  "name": "cnc-red-alert-soundboard",
  "version": "3.1.2",
  "description": "Command & Conquer Red Alert Soundboard PWA",
  "type": "module",
  "main": "js/main.js",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "test": "npm run test:security-policy && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md",
    "lint:js": "eslint --max-warnings=0 .",
    "lint:css": "stylelint css/**/*.css",
    "lint:html": "node scripts/lint-html.mjs",
    "lint:md": "markdownlint-cli2",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "typecheck": "tsc --noEmit",
    "check:generated": "npm run build && git diff --exit-code -- assets/fonts dist/css/bundle.css js/version.js sitemap.xml index.html",
    "prepare": "husky",
    "version": "node scripts/sync-version.js && git add js/version.js sitemap.xml index.html SECURITY.md",
    "build:css": "node scripts/build-css.js",
    "copy:fonts": "mkdir -p assets/fonts && cp node_modules/@fontsource/vt323/files/vt323-latin-400-normal.woff2 assets/fonts/ && cp node_modules/@fontsource/share-tech-mono/files/share-tech-mono-latin-400-normal.woff2 assets/fonts/",
    "build": "npm run copy:fonts && npm run build:css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate:security-policy": "node scripts/validate-security-policy-version.mjs",
    "test:security-policy": "node --test scripts/validate-security-policy-version.test.mjs"
  },
  "keywords": [
    "command-and-conquer",
    "red-alert",
    "soundboard",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@storybook/html-vite": "10.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "htmlhint": "^1.1.4",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.23.3",
    "semver": "7.8.5",
    "storybook": "10.6.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
